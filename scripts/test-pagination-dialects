#!/usr/bin/env bash

set -eu

script_dir="$(cd "$(dirname "$0")" && pwd)"
plugin_dir="$(cd "$script_dir/.." && pwd)"
run_id="$$"
mysql_container="tm-pagination-mysql-${run_id}"
postgres_container="tm-pagination-postgres-${run_id}"

cleanup() {
    docker rm -f "$mysql_container" >/dev/null 2>&1 || true
    docker rm -f "$postgres_container" >/dev/null 2>&1 || true
}

trap cleanup EXIT INT TERM HUP
cleanup

docker run --detach \
    --name "$mysql_container" \
    --env MYSQL_ROOT_PASSWORD=tm_pagination_root \
    --env MYSQL_DATABASE=tm_pagination \
    --env MYSQL_USER=tm_pagination \
    --env MYSQL_PASSWORD=tm_pagination \
    --network ddev-craftcms_default \
    mysql:8.4 >/dev/null
attempt=0
until docker exec "$mysql_container" mysqladmin ping -h127.0.0.1 -uroot -ptm_pagination_root --silent >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 60 ]; then
        echo "MySQL did not become ready." >&2
        exit 1
    fi
    sleep 1
done
ddev exec "TM_PAGINATION_DSN='mysql:host=${mysql_container};port=3306;dbname=tm_pagination' TM_PAGINATION_USERNAME=tm_pagination TM_PAGINATION_PASSWORD=tm_pagination php plugins/translation-manager/tests/Support/TranslationsPaginationDialectHarness.php mysql"
docker rm -f "$mysql_container" >/dev/null

docker run --detach \
    --name "$postgres_container" \
    --env POSTGRES_DB=tm_pagination \
    --env POSTGRES_USER=tm_pagination \
    --env POSTGRES_PASSWORD=tm_pagination \
    --network ddev-craftcms_default \
    postgres:16 >/dev/null
attempt=0
until docker exec "$postgres_container" pg_isready -h127.0.0.1 -U tm_pagination -d tm_pagination >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 60 ]; then
        echo "PostgreSQL did not become ready." >&2
        exit 1
    fi
    sleep 1
done
ddev exec "TM_PAGINATION_DSN='pgsql:host=${postgres_container};port=5432;dbname=tm_pagination' TM_PAGINATION_USERNAME=tm_pagination TM_PAGINATION_PASSWORD=tm_pagination php plugins/translation-manager/tests/Support/TranslationsPaginationDialectHarness.php pgsql"
docker rm -f "$postgres_container" >/dev/null

if docker inspect "$mysql_container" >/dev/null 2>&1 || docker inspect "$postgres_container" >/dev/null 2>&1; then
    echo "Disposable database container cleanup failed." >&2
    exit 1
fi

echo "Disposable MySQL and PostgreSQL pagination containers removed."
